# ==============================================================================
# RupeeTrace Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit your real '.env' with production keys or secrets to version control.
# - Optional integrations (e.g., Anthropic Claude API) fallback to deterministic
#   rule-grounded responses when credentials are not configured.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
# Host interface for Uvicorn web server
# Required: No (Default: 0.0.0.0)
HOST=0.0.0.0

# Listening TCP port
# Required: No (Default: 8000)
PORT=8000

# Debug mode (true/false) — Keep false in production
# Required: No (Default: false)
DEBUG=false

# Allowed CORS origins for browser security (comma-separated list)
# Required: No (Default: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# ------------------------------------------------------------------------------
# DATA STORAGE & PATH CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
# Relative or absolute path to the municipal road CSV and GeoJSON datasets
# Required: No (Default: Claude-Impact-Labs-data-2/data)
DATA_DIR=Claude-Impact-Labs-data-2/data

# Directory for caching computed embeddings and ML artifacts
# Required: No (Default: rupeetrace/data/cache)
CACHE_DIR=rupeetrace/data/cache

# ------------------------------------------------------------------------------
# OPTIONAL AI / LLM SERVICE INTEGRATIONS (Backend Only)
# ------------------------------------------------------------------------------
# Anthropic API Key for optional Claude LLM assistant responses.
# When absent or empty, RupeeTrace automatically operates using its
# built-in deterministic, evidence-grounded multilingual fallback engine.
# Required: No (Optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client-Exposed)
# ------------------------------------------------------------------------------
# Base URL for API requests made from the browser.
# In local dev with Vite dev server proxying, '/api' is used.
# For standalone production builds pointing to an external API, specify full URL.
# Required: No (Default: /api)
VITE_API_BASE_URL=/api
